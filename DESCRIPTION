Package: agriPairMetaFlow
Type: Package
Title: Treatment-Control Meta-Analysis Workflows for Agronomy
Version: 1.0.1
Authors@R: c(
    person(given = "Walter Esfrain", family = "Pereira",
           email = "walterufpb@yahoo.com.br",
           role = c("aut", "cre", "cph"),
           comment = c(ORCID = "0000-0003-1085-0191")),
    person(given = "Magali Haidee", family = "Pereira Martinez",
           role = "aut",
           comment = c(ORCID = "0009-0009-5419-959X"))
